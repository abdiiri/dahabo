# Copy this file to .env and fill in your Supabase project's values.
# Project Settings -> API in your Supabase dashboard.
# See docs/SUPABASE_SETUP.md for the full setup guide.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — never prefix this with VITE_, or it would be exposed to the
# browser. Required for admins to create a driver's login with a password
# directly. Keep this secret; it bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
